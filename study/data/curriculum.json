      ],
      "lessons": [
        {
          "id": "structure",
          "title": "結構、流動性與均衡"
        }
      ],
      "microFlow": [
        "intro",
        "glossary",
        "example",
        "flashcards",
        "quiz"
      ],
      "intro": "學識用 BOS／CHoCH 講結構，用流動性解釋點解假突破常見。呢章係後面打火同 FVG 嘅先修。",
      "cardCount": 9,
      "example": "上升結構：破前高=BOS；若突然破最近強低=CHoCH。假突破常發生在外部流動性（舊高低點）。"
    },
    {
