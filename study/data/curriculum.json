  "glossary": [
    {
      "term": "打火",
      "en": "Ignition",
      "def": "關鍵時間／空間誘發波動，常先假後真。"
    },
    {
      "term": "假火",
      "en": "Judas / fake ignition",
      "def": "獵殺流動性嘅誘騙突破。"
    },
    {
      "term": "PO3",
      "en": "Power of Three",
      "def": "吸籌→誘騙→分配。"
    },
    {
      "term": "BOS",
      "en": "Break of Structure",
      "def": "順勢破弱高／弱低。"
    },
    {
      "term": "CHoCH",
      "en": "Change of Character",
      "def": "破強高／強低，轉勢。"
    },
    {
      "term": "FVG",
      "en": "Fair Value Gap",
      "def": "三連 K 失衡空隙。"
    },
    {
      "term": "OB",
      "en": "Order Block",
      "def": "大行情前最後反向 K。"
    },
    {
      "term": "HTF POI",
      "en": "Higher Timeframe POI",
      "def": "大週期興趣區。"
    },
    {
      "term": "火狗彈彈波",
      "en": "Fire-dog bounce",
      "def": "HTF bias + LTF 轉勢後回踩 FVG。"
    },
    {
      "term": "SIR 城堡",
      "en": "Structure Institution RR",
      "def": "結構→機構區→風險回報。"
    },
    {
      "term": "BT/T1/T2/T3",
      "en": "US Eastern session blocks",
      "def": "美東時段；EDT 與 EST 差 1 小時。"
    },
    {
      "term": "HVN/LVN",
      "en": "High/Low Volume Node",
      "def": "成交密集／稀疏區。"
    }
  ],
